local function addModifierToPart(part)
	if part:IsA("BasePart") and not part:FindFirstChildOfClass("PathfindingModifier") then
		local modifier = Instance.new("PathfindingModifier")
		modifier.PassThrough = true
		modifier.Parent = part
	end
end

local function ignoreItemObject(item)
	if item:IsA("BasePart") then
		addModifierToPart(item)
	elseif item:IsA("Model") then
		for _, part in ipairs(item:GetDescendants()) do
			addModifierToPart(part)
		end
		-- 모델 내부에 나중에 추가되는 파트까지 추적
		item.DescendantAdded:Connect(addModifierToPart)
	end
end

-- 📍 게임 시작 시 기존 아이템 처리 및 앞으로 추가될 실시간 감지 이벤트 등록
local function initRealtimeIgnore()
	local itemsFolder = workspace:WaitForChild("Items", 5)
	if not itemsFolder then return end
	
	-- 1. 기존에 이미 맵에 존재하던 아이템들 먼저 전부 무시 처리
	for _, item in ipairs(itemsFolder:GetChildren()) do
		ignoreItemObject(item)
	end
	
	-- 2. 🔥 [핵심] 앞으로 새롭게 추가되는 아이템 오브젝트 실시간 무시 처리
	itemsFolder.ChildAdded:Connect(function(newItem)
		task.wait() -- 오브젝트가 완전히 로드될 때까지 1프레임 대기
		ignoreItemObject(newItem)
	end)
end

local function showWaypoints(waypoints)
	local oldFolder = workspace:FindFirstChild("DebugWaypointFolder")
	if oldFolder then oldFolder:Destroy() end
	
	local folder = Instance.new("Folder")
	folder.Name = "DebugWaypointFolder"
	folder.Parent = workspace
	
	for i, waypoint in ipairs(waypoints) do
		local part = Instance.new("Part")
		part.Shape = Enum.PartType.Ball
		part.Size = Vector3.new(1.2, 1.2, 1.2)
		part.Position = waypoint.Position
		part.Anchored = true
		part.CanCollide = false
		
		if i == 1 then
			part.Color = Color3.fromRGB(0, 255, 0)
		elseif i == #waypoints then
			part.Color = Color3.fromRGB(255, 0, 0)
		elseif waypoint.Action == Enum.PathWaypointAction.Jump then
			part.Color = Color3.fromRGB(255, 255, 0)
		else
			part.Color = Color3.fromRGB(0, 170, 255)
		end
		
		local billboard = Instance.new("BillboardGui")
		billboard.Size = UDim2.new(0, 40, 0, 20)
		billboard.AlwaysOnTop = true
		billboard.StudsOffset = Vector3.new(0, 1.5, 0)
		
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.TextColor3 = part.Color
		label.TextSize = 12
		label.Text = tostring(i)
		label.Parent = billboard
		
		billboard.Parent = part
		part.Parent = folder
	end
end

local function walkAlongWaypoints(waypoints)
	local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
	local humanoid = character:WaitForChild("Humanoid")
	local rootPart = character:WaitForChild("HumanoidRootPart")
	
	humanoid.WalkSpeed = WALK_SPEED
	humanoid.PlatformStand = false
	rootPart.Anchored = false
	
	print("이린이 속도로 가겠다 컹")
	
	for i = 2, #waypoints - 1 do
		local targetWaypoint = waypoints[i]
		
		if targetWaypoint.Action == Enum.PathWaypointAction.Jump then
			humanoid.Jump = true
		end
		
		humanoid:MoveTo(targetWaypoint.Position)
		task.wait() 
	end
	
	local finalWaypoint = waypoints[#waypoints]
	humanoid:MoveTo(finalWaypoint.Position)
	humanoid.MoveToFinished:Wait()
	
	print("에너지음료 6캔 먹고 도착했다 컹")
end

local function startPathfindingProcess(targetPosition)
	local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
	local rootPart = character:WaitForChild("HumanoidRootPart")
	
	local path = PathfindingService:CreatePath({
		AgentRadius = 2,
		AgentHeight = 5,
		AgentCanJump = true
	})
	
	local success, errorMessage = pcall(function()
		path:ComputeAsync(rootPart.Position, targetPosition)
	end)
	
	if success and path.Status == Enum.PathStatus.Success then
		local waypoints = path:GetWaypoints()
		showWaypoints(waypoints)
		walkAlongWaypoints(waypoints)
	else
		warn("❌ 경로 생성 실패 상태: " .. tostring(path.Status) .. " | 에러: " .. tostring(errorMessage))
	end
end

