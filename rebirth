-- [나갈 때] 이 함수를 호출하면 브섭 정보를 저장하고 재접속합니다.
local function safeRejoinVIPServer()
    local psId = game.PrivateServerId
    local psOwnerId = workspace:GetAttribute("privateServerOwnerId") or game.PrivateServerOwnerId
    
    if writefile and HttpService then
        local statusData = {
            isRejoining = true,
            privateServerId = psId,
            privateServerOwnerId = psOwnerId,
            timestamp = os.time()
        }
        writefile(statusFilePath, HttpService:JSONEncode(statusData))
    end
    
    task.wait(0.5)
    
    if psId and psId ~= "" then
        pcall(function()
            TeleportService:TeleportToPrivateServer(game.PlaceId, psId, {LocalPlayer})
        end)
    else
        pcall(function()
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end)
    end
end

