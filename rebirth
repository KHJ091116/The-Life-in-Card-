local function EatAll()
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local byteNetReliable = ReplicatedStorage:WaitForChild("ByteNetReliable")

    local function eatItemByEntityID(idNumber)
	    local itemBuffer = buffer.create(6)
	    buffer.writeu8(itemBuffer, 0, 0)
	    buffer.writeu8(itemBuffer, 1, 52)
	    buffer.writeu16(itemBuffer, 2, idNumber)
	    buffer.writeu8(itemBuffer, 4, 0)
	    buffer.writeu8(itemBuffer, 5, 0)
	    byteNetReliable:FireServer(itemBuffer)
    end
    for i, v in workspace.Items:GetChildren() do
        if v.Name ~= "Essence" then continue end
        eatItemByEntityID(v:GetAttribute("EntityID"))
        print(v:GetAttribute("EntityID"))
    end
end
